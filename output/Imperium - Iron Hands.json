        },
        {
          "name": "Iron Father",
          "type": "Abilities",
          "characteristics": {
            "description": "While this model is within 3\" of a friendly ADEPTUS ASTARTES VEHICLE unit, this model has Lone Operative."
          }
        },
        {
          "name": "Master of the Forge",
          "type": "Abilities",
          "characteristics": {
            "description": "In your Movement phase, at the start or end of this unit’s move, you can select one friendly Adeptus Astartes Vehicle model within 3\" of this model:\n\n\n- That Vehicle model heals 3 wounds.\n- That Vehicle model’s attacks can ignore modifiers to the following until the start of your next Movement phase:\n- BS.\n- Hit rolls and wound rolls."
          }
        },
        {
          "name": "Leader",
          "type": "Abilities",
          "characteristics": {
            "description": "This model can be attached to the following units:\nAGGRESSOR SQUAD, ERADICATOR SQUAD WITH HEAVY BOLTERS, ERADICATOR SQUAD WITH MELTA RIFLES, HEAVY INTERCESSOR SQUAD"
          }
        }
