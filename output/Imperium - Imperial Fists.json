      "profiles": [
        {
          "name": "Pedro Kantor",
          "type": "Unit",
          "characteristics": {
            "m": "6\"",
            "t": "4",
            "sv": "2+",
            "w": "5",
            "ld": "6+",
            "oc": "1",
            "insv": "4+",
            "base": "32mm"
          }
        },
        {
          "name": "Oath of Rynn",
          "type": "Abilities",
          "characteristics": {
            "description": "Once per battle, at the start of either player’s Command phase, this model can use this ability. When it does, until the end of the turn, add 1 to the Attacks characteristic of weapons equipped by models in this model’s unit."
          }
        },
        {
          "name": "To the Last",
          "type": "Abilities",
          "characteristics": {
            "description": "While this model is leading a unit, each time a model in that unit makes an attack, add 1 to the Hit roll if that unit is below its Starting Strength, and add 1 to the Wound roll as well if that unit is Below Half-strength."
          }
        },
        {
          "name": "Leader",
          "type": "Abilities",
          "characteristics": {
            "description": "This model can be attached to the following units:\n\n■ BLADEGUARD VETERAN SQUAD\n■ COMPANY HEROES\n■ STERNGUARD VETERAN SQUAD\n■ TACTICAL SQUAD"
          }
        },
        {
          "name": "Inspiring Commander",
          "type": "Abilities",
          "characteristics": {
            "description": "If you include this model in your army, until the end of the battle, non-Character models in Sternguard\nVeteran Squad units from your army have an Objective Control characteristic of 2 while they are not Battle-shocked."
          }
        }
      ],
      "rules": []
